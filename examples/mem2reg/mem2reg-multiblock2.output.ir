fun unit @sink (i32) {
init:
  bid: b0
  allocations:

block b0:
  %b0:p0:i32
  ret unit:unit
}

fun i32 @multi_block () {
init:
  bid: b0
  allocations:
    %l0:i32:x

block b0:
  %b0:i0:unit = nop

  %b0:i1:unit = nop
  %b0:i2:unit = nop

  %b0:i3:unit = nop
  %b0:i4:unit = nop

  j b2()

block b2:
  %b2:i0:unit = nop
  j b1()

block b1:
  %b1:i0:unit = nop
  %b1:i1:unit = call @sink:[ret:unit params:(i32)]*(undef:i32)
  %b1:i2:unit = call @sink:[ret:unit params:(i32)]*(42:i32)
  %b1:i3:unit = call @sink:[ret:unit params:(i32)]*(37:i32)
  %b1:i4:unit = call @sink:[ret:unit params:(i32)]*(99:i32)

  ret 0:i32
}